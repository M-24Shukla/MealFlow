{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:integration": "RUN_SUPABASE_INTEGRATION_TESTS=1 vitest run",
    "test:smoke": "RUN_SUPABASE_INTEGRATION_TESTS=1 vitest run -t 'manages ordered menus|applies attendance precedence|honors producer leave'",
    "lint": "oxlint src",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
