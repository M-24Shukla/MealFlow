# Copy the Session pooler connection string from Supabase Connect, then add sslmode and sslrootcert.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/prod-supabase.cer
ALLOWED_CORS_ORIGINS=http://localhost:5173
PORT=3000
SESSION_TTL_DAYS=14
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
SESSION_COOKIE_DOMAIN=
NODE_ENV=development
