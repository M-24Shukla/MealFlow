# Copy the Transaction pooler connection string from Supabase Connect for Netlify.
# Local development can also use the Session pooler. Replace only the password placeholder.
# SSL uses the public root CA bundled in src/db/supabase-ca.ts.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[POOLER_HOST]:6543/postgres
ALLOWED_CORS_ORIGINS=http://localhost:5173
PORT=3000
SESSION_TTL_DAYS=14
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
SESSION_COOKIE_DOMAIN=
NODE_ENV=development
