# Copy the Session pooler connection string from Supabase Connect. SSL is configured from prod-supabase.cer by the backend.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
ALLOWED_CORS_ORIGINS=http://localhost:5173
PORT=3000
SESSION_TTL_DAYS=14
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
SESSION_COOKIE_DOMAIN=
NODE_ENV=development
